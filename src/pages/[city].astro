---
import Base from "../layouts/Base.astro";
import Exclusion from "../components/Exclusion.astro";
import { cities } from "../data/cities";
import type { City } from "../data/cities";

export function getStaticPaths() {
  return cities.map((city) => ({ params: { city: city.slug }, props: { city } }));
}

interface Props {
  city: City;
}

const { city } = Astro.props;

const index = cities.findIndex((c) => c.slug === city.slug);
const others = [1, 2, 3].map((step) => cities[(index + step) % cities.length]!);

const clubsSentence =
  city.clubs.length > 1
    ? `U SuperSport HNL-u grad ${city.name} predstavljaju ${city.clubs.join(", ")}.`
    : `U SuperSport HNL-u grad ${city.name} predstavlja ${city.clubs[0]}.`;

const phoneE164 = `+385${city.facility.phone.replaceAll(" ", "").slice(1)}`;
const phoneHref = `tel:${phoneE164}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  name: city.facility.name,
  url: city.facility.url,
  telephone: phoneE164,
  address: {
    "@type": "PostalAddress",
    streetAddress: city.facility.address.split(",")[0],
    addressLocality: city.name,
    addressCountry: "HR",
  },
};
---

<Base
  title={`Liječenje ovisnosti o kockanju u ${city.nameLoc} | SHNL`}
  description={`Gdje potražiti pomoć kod ovisnosti o kockanju u ${city.nameLoc}: ${city.facility.name}, adresa, telefon i način naručivanja.`}
  path={`/${city.slug}/`}
  jsonLd={jsonLd}
>
  <h1>Liječenje ovisnosti o kockanju u {city.nameLoc}</h1>
  <p class="clubs">{clubsSentence}</p>
  <p class="lead">
    Ako kockanje ili klađenje stvara probleme vama ili nekome bliskom, pomoć
    postoji i dostupna je. U nastavku su podaci ustanove u kojoj možete
    potražiti stručnu podršku.
  </p>

  <section class="facility">
    <h2>{city.facility.name}</h2>
    <p>{city.facility.description}</p>
    <ul class="contact">
      <li>
        <span class="c-label">Adresa</span>
        <span>{city.facility.address}</span>
      </li>
      <li>
        <span class="c-label">Telefon</span>
        <span><a href={phoneHref}>{city.facility.phone}</a></span>
      </li>
      {
        city.facility.email && (
          <li>
            <span class="c-label">Email</span>
            <span><a href={`mailto:${city.facility.email}`}>{city.facility.email}</a></span>
          </li>
        )
      }
      <li>
        <span class="c-label">Web</span>
        <span><a href={city.facility.url} rel="noopener">Službena stranica ustanove</a></span>
      </li>
    </ul>
  </section>

  <Exclusion />

  <h2>Pomoć u drugim gradovima</h2>
  <ul>
    {
      others.map((o) => (
        <li>
          <a href={`/${o.slug}/`}>Liječenje ovisnosti o kockanju u {o.nameLoc}</a>
        </li>
      ))
    }
  </ul>
  <p><a href="/">Natrag na kartu svih gradova</a></p>
</Base>

<style>
  .clubs {
    margin-top: -0.25rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .lead {
    font-size: 1.125rem;
  }
  .facility {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.4rem 1.5rem;
    margin: 2rem 0;
  }
  .facility h2 {
    margin-top: 0;
    font-size: 1.3rem;
  }
  .facility > p {
    font-size: 0.95rem;
  }
  .contact {
    list-style: none;
    padding: 0.35rem 0 0;
    margin: 0;
  }
  .contact li {
    display: flex;
    gap: 1rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--line);
  }
  .c-label {
    flex: 0 0 4.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.2rem;
  }
</style>
